  "story": {
    "title": "命痕残卷",
    "speaker": "阿烬",
    "role": "守卷人",
    "chapters": [
      {
        "id": "awakening",
        "title": "无名庙中醒来",
        "at": 1,
        "lines": [
          [
            "你",
            "雨从破瓦间落下。你握着一截烧焦的书脊，想不起自己为何会来到这里。"
          ],
          [
            "阿烬",
            "别找剑了。你这一世，连剑也没能留下。"
          ],
          [
            "阿烬",
            "拿灵石照一照这页残卷。前人留下的命痕，还肯借你一剑。"
          ]
        ],
        "pack": "battle"
      },
      {
        "id": "borrowed-blade",
        "title": "借来的一剑",
        "at": 1,
        "lines": [
          [
            "你",
            "空白的书页上浮出一道剑痕。握剑的记忆忽然清晰，手上的旧伤却不是你的。"
          ],
          [
            "阿烬",
            "借来的不只是力气。有人在这道命痕里，练了一辈子的剑。"
          ],
          [
            "阿烬",
            "去山路上试试。斩来的灵石能照亮下一页；山门后的守卫，会告诉你还缺什么。"
          ]
        ],
        "when": "draw"
      },
      {
        "id": "first-gate",
        "title": "山门无门",
        "at": 1,
        "lines": [
          [
            "你",
            "山路尽头没有山门，只有妖物守着一座倒塌的石碑。"
          ],
          [
            "阿烬",
            "山野小妖给你积蓄，守卫才让你往前。别把两条路走混了。"
          ],
          [
            "阿烬",
            "赢下这一关，残卷便能听见更完整的传承。若敌不过，回来再借几道命痕。"
          ]
        ],
        "when": "mob"
      },
      {
        "id": "living-script",
        "title": "书页会呼吸",
        "at": 2,
        "lines": [
          [
            "你",
            "石碑碎裂时，一行经文自行爬上书页。"
          ],
          [
            "阿烬",
            "光有蛮力，走不远。功法记下的是前人如何出手：蓄剑意，立护盾，或借灵契。"
          ],
          [
            "阿烬",
            "试着寻一门功法。第一门会自动主修；之后你可以亲手更换自己的路。"
          ]
        ],
        "pack": "technique"
      },
      {
        "id": "spirit-contract",
        "title": "命痕唤来同伴",
        "at": 2,
        "pack": "pet",
        "when": "spirit",
        "lines": [
          [
            "你",
            "御灵经文刚落入识海，卷外便响起一声回应。可书页分明还没翻到这里。"
          ],
          [
            "阿烬",
            "路不总按页码来。你先遇见御灵命痕，它便替你唤来灵契。"
          ],
          [
            "阿烬",
            "御兽机缘已经提前开放。寻一位同伴，让这门功法真正连成你的第一套构筑。"
          ]
        ]
      },
      {
        "id": "old-objects",
        "title": "旧物认主",
        "at": 3,
        "lines": [
          [
            "你",
            "荒道旁散落着无人认领的旧器，一枚灵纹仍微微发亮。"
          ],
          [
            "阿烬",
            "残卷能照见器物的旧主，也能让旧器重新认主。抽到的装备会先补空槽。"
          ],
          [
            "阿烬",
            "药草与基础丹炉也用得上了。它们护你走得更远，真正改变根骨的机缘，仍要向卷中寻。"
          ]
        ],
        "pack": "equipment"
      },
      {
        "id": "shelter",
        "title": "为这一世留盏灯",
        "at": 4,
        "lines": [
          [
            "你",
            "风雨又起。残卷上却多出了一座不曾见过的山中小院。"
          ],
          [
            "阿烬",
            "连洞府也能成为命痕。抽到灵田，便有药草自生；抽到聚灵阵，闭关便多一分所得。"
          ],
          [
            "阿烬",
            "先试着寻一座洞府。基础采药和回春丹不必等它，别在雨里干站着。"
          ]
        ],
        "pack": "cave"
      },
      {
        "id": "answering-beast",
        "title": "卷外有回应",
        "at": 5,
        "lines": [
          [
            "你",
            "林间传来一声细鸣。残卷里的灵纹随之亮起，像在回答。"
          ],
          [
            "阿烬",
            "不是所有前人都独自上路。有些命痕里，还留着同伴的约定。"
          ],
          [
            "阿烬",
            "寻一次御兽灵契。灵宠与功法的共鸣，会让同一张书页走出不同的路。"
          ]
        ],
        "pack": "pet"
      },
      {
        "id": "insight",
        "title": "山高一寸",
        "at": 6,
        "lines": [
          [
            "你",
            "灵气在经脉里积了许久，石碑上那道裂缝却始终没有扩大。"
          ],
          [
            "阿烬",
            "修为靠日夜积累，悟道要一个契机。修为造化每次至少添一点悟道。"
          ],
          [
            "阿烬",
            "先认得这条路。过了山麓的Boss，下一张地图会问你的境界，而不只问你的剑。"
          ]
        ],
        "pack": "cultivation"
      },
      {
        "id": "wolf",
        "title": "渡口前的长啸",
        "at": 8,
        "lines": [
          [
            "你",
            "长啸从渡口传来。前面的脚印在这里折返，没有一行跨过河去。"
          ],
          [
            "阿烬",
            "首领有自己的杀招。翻看守关准备，检查功法、灵宠和丹药；命痕要搭起来才有用。"
          ],
          [
            "阿烬",
            "你不必照着某一位前人重走。选好你的组合，再去试一次。"
          ]
        ]
      },
      {
        "id": "fortune",
        "title": "竹谷有来客",
        "at": 9,
        "lines": [
          [
            "你",
            "渡过青云，竹叶间有铜钱相碰的声音。一名行商望着残卷，竟先向它行了礼。"
          ],
          [
            "阿烬",
            "聚财命痕记下了另一些人的一生。它们改变的，是往后每次修行的所得。"
          ],
          [
            "阿烬",
            "眼前一剑，与长久的经营，值得各留一页。新地图还须境界相配，别忘了回看突破条件。"
          ]
        ],
        "pack": "wealth"
      },
      {
        "id": "alchemy",
        "title": "丹火照旧名",
        "at": 10,
        "lines": [
          [
            "你",
            "丹炉的火映在书上，照出几种从未见过的药名。"
          ],
          [
            "阿烬",
            "基础丹药可以自己经营。高级配方和突破丹，则要从丹道命痕里寻。"
          ],
          [
            "阿烬",
            "每二十次普通寻缘，残卷许你自择一道已开放的核心机缘。运气决定先见谁，积累让你选定要走的路。"
          ]
        ],
        "pack": "elixir"
      },
      {
        "id": "forest",
        "title": "有人还在林中",
        "at": 17,
        "lines": [
          [
            "你",
            "鬼林里，斩开的伤口转眼愈合。残卷的一角却被什么东西烧得发烫。"
          ],
          [
            "阿烬",
            "一味添力气，会与这片林子耗到天亮。看看压制回复的命痕，或改走另一种构筑。"
          ],
          [
            "阿烬",
            "同名核心在一、三、六份留下不同的痕迹。重复相逢，也能读出新的东西。"
          ]
        ]
      },
      {
        "id": "mirror",
        "title": "剑冢照见来人",
        "at": 25,
        "lines": [
          [
            "你",
            "雾后的断剑一齐转向你。你挥出的剑意，竟从对面原样折回。"
          ],
          [
            "阿烬",
            "此地会反震修士的伤害。灵宠分担输出，护盾与丹药留住性命；足够熟练的命痕，也有自己的解法。"
          ],
          [
            "阿烬",
            "这一回，不必再只问怎样打得更痛。"
          ]
        ]
      },
      {
        "id": "signature",
        "title": "卷末有你的名字",
        "at": 32,
        "lines": [
          [
            "你",
            "最后一柄断剑落下。残卷翻到空白页，慢慢写出一个名字——你的名字。"
          ],
          [
            "阿烬",
            "它记下的不止前人。你这一世发现的机缘，也终于有了来处。"
          ],
          [
            "阿烬",
            "再走一世时，选两道不同的核心命痕刻进书脊。余下的留在见闻里；下一世，你便是自己的前人。"
          ]
        ],
        "when": "cleared"
      },
      {
        "id": "artifact",
        "title": "留一件本命",
        "at": 30,
        "lines": [
          [
            "你",
            "筑基之后，那些只可远观的法器命痕终于能落在掌心。"
          ],
          [
            "阿烬",
            "这是独立于普通装备的本命槽。法器能把既有构筑再推一步，却仍属于这一世。"
          ],
          [
            "阿烬",
            "走之前，仍可选择继续修行。轮回的时机，在你手中。"
          ]
        ],
        "pack": "artifact",
        "when": "foundation"
      }
    ],
    "return": {
      "id": "return",
      "title": "你已是自己的前人",
      "at": 1,
      "lines": [
        [
          "你",
          "雨仍从破瓦间落下。这一次，你认得掌中残卷，也认得卷脊上留下的命痕。"
        ],
        [
          "阿烬",
          "你选的传承已经带来，走过的机缘之路也不必再锁。要重修旧路，还是换两页试试？"
        ],
        [
          "阿烬",
          "前世的积累让你更早作选择。这一世，记下些不同的东西吧。"
        ]
      ]
    }
  }
}
